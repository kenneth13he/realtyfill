{
  "name": "realtyfill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "test:py": "python -m unittest discover -s pdf-service -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "audit:fill": "tsx scripts/fill_audit.ts && python scripts/fill_audit.py",
    "test:e2e": "tsx scripts/e2e_fill_check.ts",
    "check": "npm run typecheck && npm test && npm run test:py && npm run audit:fill"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
